includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    excludePaths:
        analyse:
            - tests/Pest.php
    peststan:
        testCaseClass: IllumaLaw\LlmRouter\Tests\TestCase
